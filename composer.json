{
  "name": "saurabhsharma/dl-data-extractor",
  "description": "A simple class to return Driving License information, such as Driver First Name, Last Name, License Number etc.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "driving License data Extractor",
    "pdf14 data extractor",
    "DL parsing"
  ],
  "authors": [
    {
      "role": "Developer",
      "name": "Saurabh Sharma",
      "email": "saurabhsharma2u@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "autoload": {
    "psr-4": {
      "SaurabhSharma\\DLExtractor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SaurabhSharma\\Tests\\DLExtractor\\": "Tests/"
    }
  },
  "require": {
    "php": "^8.2 || ^8.3"
  },
  "require-dev": {
    "pestphp/pest": "^3.0",
    "phpstan/phpstan": "^1.11"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "prefer-stable": true,
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/phpstan analyse src --level=1 --no-progress"
  }
}
